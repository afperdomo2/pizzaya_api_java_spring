{
	"info": {
		"_postman_id": "pizzaya-api-collection",
		"name": "PizzaYa API",
		"description": "Colección de endpoints para la API de gestión de pizzas PizzaYa. Incluye autenticación JWT, gestión de pizzas, órdenes y clientes.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8082/pizzaya/api",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Sign In",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var token = pm.response.headers.get('Authorization');",
									"    if (token) {",
									"        pm.collectionVariables.set('jwt_token', token.replace('Bearer ', ''));",
									"        pm.environment.set('jwt_token', token.replace('Bearer ', ''));",
									"        console.log('Token JWT guardado automáticamente');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/sign-in",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"sign-in"
							]
						},
						"description": "Iniciar sesión y obtener token JWT. El token se guarda automáticamente en las variables de colección."
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticación"
		},
